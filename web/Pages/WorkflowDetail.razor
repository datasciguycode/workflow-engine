@page "/workflow/{WorkflowId}"
@using System.Text.Json.Nodes
@inject WorkflowApiClient Api
@inject IJSRuntime JS

<PageTitle>Workflow</PageTitle>

@if (_error is not null)
{
    <FluentMessageBar Intent="MessageBarIntent.Error">@_error</FluentMessageBar>
}
else if (_stages is null || _items is null)
{
    <FluentSpinner />
}
else
{
    <div class="page-header">
        <div class="page-header-back">
            @if (_selectedStageId is not null && _selectedItem is not null)
            {
                <FluentLink @onclick="BackToItem" Class="back-link">&larr; Stages</FluentLink>
            }
            else if (_selectedItem is not null)
            {
                <FluentLink @onclick="BackToList" Class="back-link">&larr; @ItemLabelPlural</FluentLink>
            }
            else if (_newJobMode)
            {
                <FluentLink @onclick="CancelNewJob" Class="back-link">&larr; @ItemLabelPlural</FluentLink>
            }
            else
            {
                <FluentLink Href="./" Class="back-link">&larr; Workflows</FluentLink>
            }
        </div>
        <div class="page-header-chat">
            @* Hidden on the bare Jobs list (2026-11-08): chat should only ever create a job or
               act on one you've actually opened, never reference another job by name/number
               from the list -- so it only appears once "+ New Job" is clicked, or once a job
               (overview or a specific stage) is open. *@
            @if (_newJobMode || _selectedItem is not null)
            {
                <FluentButton Appearance="ButtonAppearance.Primary" @onclick="FocusChatInput">
                    &#128172; Chat
                </FluentButton>
            }
        </div>
        <div class="page-header-toggle">
            <ThemeToggleButton />
        </div>
    </div>

    @if (_selectedStageId is not null && _selectedItem is not null)
    {
        <h1 style="overflow-wrap:anywhere; word-break:break-word;">Job #@JobNumber(_selectedItem) &mdash; @StageTitle(_selectedStageId)</h1>
        @if (_stages.FirstOrDefault(s => s.Id == _selectedStageId) is { Checklist.Count: > 0 } selectedStage)
        {
            <FluentStack Orientation="Orientation.Vertical" VerticalGap="2" Style="margin-bottom:12px;">
                @foreach (var field in selectedStage.Checklist)
                {
                    var done = _selectedItem.Data.TryGetPropertyValue(field, out var v) && v is not null;
                    <div style="opacity:0.75;">@(done ? "☑" : "☐") @ChecklistLabel(field)</div>
                }
            </FluentStack>
        }
        @foreach (var (key, value) in ItemFieldsForStage(_selectedItem, _selectedStageId))
        {
            <div class="field-row" style="white-space:pre-wrap; overflow-wrap:anywhere; word-break:break-word;">
                <span class="field-key">@ChecklistLabel(key):</span> @FieldText(key, value)
            </div>
        }
        @if (_stages.FirstOrDefault(s => s.Id == _selectedStageId)?.Checklist.Contains("scheduled_at") == true)
        {
            var upcoming = UpcomingAppointments().ToList();
            <h2>Other Appointments:</h2>
            @if (upcoming.Count == 0)
            {
                <p style="opacity:0.6;">No upcoming appointments scheduled.</p>
            }
            else
            {
                <FluentStack Orientation="Orientation.Vertical" VerticalGap="8" Style="margin-bottom:12px;">
                    @foreach (var (item, when) in upcoming)
                    {
                        <div style="opacity:0.85;">
                            <div>Job #@JobNumber(item) &mdash; @when.ToString("MMM d, h:mm tt", System.Globalization.CultureInfo.InvariantCulture)</div>
                            <div>@ItemTitle(item)</div>
                        </div>
                    }
                </FluentStack>
            }
        }
    }
    else if (_selectedItem is not null)
    {
        <h1>Job #@JobNumber(_selectedItem)</h1>
        <h2>Stages</h2>
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="6">
            @foreach (var stage in _stages.OrderBy(s => s.SequenceOrder ?? int.MaxValue))
            {
                var isCurrent = stage.Id == _selectedItem.StageId;
                <FluentCard Class="clickable-card" style="@($"padding:10px 14px; max-width:100%; box-sizing:border-box; border-radius:var(--app-radius); {(isCurrent ? "border: 2px solid var(--app-accent);" : "")}")"
                            @onclick="() => SelectStage(stage.Id)">
                    <strong style="color:var(--app-accent);">@Capitalize(stage.Title.Replace('_', ' ')) &rarr;</strong> @if (isCurrent) { <span class="current-badge">current</span> }
                    @if (stage.Checklist.Count > 0)
                    {
                        <div style="margin-top:6px; display:flex; flex-direction:column; gap:2px;" @onclick:stopPropagation="true">
                            @foreach (var field in stage.Checklist)
                            {
                                var done = _selectedItem.Data.TryGetPropertyValue(field, out var v) && v is not null;
                                <div style="opacity:0.75; font-size:0.9em;">@(done ? "☑" : "☐") @ChecklistLabel(field)</div>
                            }
                        </div>
                    }
                </FluentCard>
            }
        </FluentStack>
    }
    else if (_newJobMode)
    {
        <h1>New @ItemLabelSingular</h1>
        @if (_stages.FirstOrDefault(s => s.IsInitial) is { } initialStage)
        {
            <p style="opacity:0.75;">Starts in <strong>@Capitalize(initialStage.Title)</strong>. Tell the chat below about it.</p>
            @if (initialStage.Checklist.Count > 0)
            {
                <FluentStack Orientation="Orientation.Vertical" VerticalGap="2">
                    @foreach (var field in initialStage.Checklist)
                    {
                        <div style="opacity:0.75;">&#9744; @ChecklistLabel(field)</div>
                    }
                </FluentStack>
            }
        }
    }
    else
    {
        <h1>@ItemLabelPlural</h1>
        <FluentLink @onclick="StartNewJob" Class="back-link">+ New @ItemLabelSingular</FluentLink>

        @* Tap-to-search (2026-11-08): no live-as-you-type filtering, so searching never fires a
           request per keystroke -- the box just holds text until Search is tapped, and runs
           server-side via search_items (matches job data, stage title, and job number; see
           that migration) rather than filtering the already-loaded _items client-side. *@
        <div style="display:flex; gap:8px; margin-top:12px; align-items:flex-start;">
            <FluentTextInput @bind-Value="_searchQuery" Placeholder="Search jobs..." Style="flex:1;"
                              @onkeyup="@(async (KeyboardEventArgs e) => { if (e.Key == "Enter") await RunSearch(); })" />
            <FluentButton Appearance="ButtonAppearance.Primary" Disabled="@_searching" @onclick="RunSearch">
                @(_searching ? "..." : "Search")
            </FluentButton>
            @if (_searchResults is not null)
            {
                <FluentButton @onclick="ClearSearch">Clear</FluentButton>
            }
        </div>

        @if (_searchResults is not null)
        {
            <p style="opacity:0.6; margin-top:8px;">@_searchResults.Count result(s) for "@_searchQuery"</p>
            <FluentStack Orientation="Orientation.Vertical" VerticalGap="8" Style="margin-top:8px;">
                @foreach (var result in _searchResults)
                {
                    var item = new ItemSummary(result.Id, result.StageId, result.Data, result.CreatedAt);
                    <FluentCard Class="clickable-card" style="padding:14px; max-width:100%; box-sizing:border-box; border-radius:var(--app-radius);" @onclick="() => SelectItem(item)">
                        <div style="white-space:pre-wrap; overflow-wrap:anywhere; word-break:break-word;">
                            <strong style="color:var(--app-accent);">#@result.JobNumber @ItemTitle(item) &rarr;</strong>
                        </div>
                        <div style="opacity:0.7; margin-top:2px;">Stage: @StageTitle(item.StageId)</div>
                    </FluentCard>
                }
            </FluentStack>
        }
        else
        {
            <FluentStack Orientation="Orientation.Vertical" VerticalGap="8" Style="margin-top:12px;">
                @foreach (var item in _items)
                {
                    <FluentCard Class="clickable-card" style="padding:14px; max-width:100%; box-sizing:border-box; border-radius:var(--app-radius);" @onclick="() => SelectItem(item)">
                        <div style="white-space:pre-wrap; overflow-wrap:anywhere; word-break:break-word;">
                            <strong style="color:var(--app-accent);">#@JobNumber(item) @ItemTitle(item) &rarr;</strong>
                        </div>
                        <div style="opacity:0.7; margin-top:2px;">Stage: @StageTitle(item.StageId)</div>
                    </FluentCard>
                }
            </FluentStack>
        }
    }

    @if (_selectedStageId is null && _selectedItem is not null)
    {
        <h2>Details</h2>
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="4">
            @foreach (var (key, value) in ItemFields(_selectedItem))
            {
                <div class="field-row" style="white-space:pre-wrap; overflow-wrap:anywhere; word-break:break-word;">
                    <span class="field-key">@ChecklistLabel(key):</span> @FieldText(key, value)
                </div>
            }
        </FluentStack>
    }

    @* The job overview page gets its own chat box again (2026-11-08) -- reversing 2026-11-04's
       removal, now that notes can be tagged job-level (no stage) vs. stage-level: the overview
       page is where a job-level note belongs, so it needs a "Save as note" checkbox and a Send
       button of its own, not just the stage views.
       Still no chat box on the bare Jobs list -- it only appears once "+ New Job" is clicked
       (create-only there) or once a job (overview or a specific stage) is open. See the header
       button above for the matching condition. *@
    @if (_newJobMode || _selectedItem is not null)
    {
        <h2>Chat</h2>

        @* Autofocus removed 2026-10-30: doesn't open iOS's keyboard anyway (confirmed 2026-10-25),
           but Safari still scroll-jumps the page to bring this box into view on every load, hiding
           the Talk button and back-link above it. The Talk button is the real focus mechanism now. *@
        @* Stacked and left-aligned, not a row trying to match edges with the textbox below it --
           the fluent-textarea component's real right edge turned out to not be where its own
           width:100% box implies (2026-11-08, after the fluent-text-area selector-typo fix still
           didn't close the gap), so this gives up on lining edges up at all rather than chasing it
           further. *@
        @if (_selectedItem is not null)
        {
            <FluentCheckbox @bind-Value="_saveAsNote">Save as note</FluentCheckbox>
        }
        @* Rows alone (2 -> 3) didn't produce a visible height change -- the fluent-textarea web
           component doesn't appear to size off its rows attribute reliably, so force the height
           directly via CSS instead (2026-11-08). *@
        <FluentTextArea id="chat-input" @bind-Value="_draft" Rows="3" Style="width:100%; min-height:6rem;" />
        <div style="display:flex; flex-wrap:wrap; gap:8px; margin-top:8px; margin-bottom:12px;">
            <FluentButton Appearance="ButtonAppearance.Primary" Disabled="@_sending" @onclick="Send">
                @(_sending ? "Sending..." : "Send")
            </FluentButton>
            @if (_selectedStageId is not null && DoneNextStage() is { } nextStage)
            {
                <FluentButton Appearance="ButtonAppearance.Primary" Disabled="_movingStage" @onclick="() => DoneMoveToNextStage(nextStage.Id)">
                    Complete Stage
                </FluentButton>
            }
        </div>

        @* Moved below the text box/buttons, above the chat log (2026-11-08) -- notes used to sit
           above the chat box and, on a long-running job/stage, pushed the box (and the Complete
           Stage button) further down the page the more notes piled up. The input now stays right
           under the heading regardless of notes/log length. Stage view shows that stage's own
           notes; the job overview page shows job-level (no stage) notes -- see NotesFor(). *@
        @if (_selectedItem is not null)
        {
            <h2>Notes</h2>
            var notesToShow = NotesFor(_selectedStageId);
            @if (_notes is null)
            {
                <FluentSpinner />
            }
            else if (notesToShow.Count == 0)
            {
                <p style="opacity:0.6;">No notes yet.</p>
            }
            else
            {
                @* VerticalGap on FluentStack doesn't reliably produce visible spacing (same issue
                   as the chat textarea's Rows attribute, 2026-11-08) -- force it with an explicit
                   margin-bottom on each note instead. *@
                <FluentStack Orientation="Orientation.Vertical" VerticalGap="20">
                    @foreach (var note in notesToShow)
                    {
                        <div style="margin-bottom:20px;">
                            <div style="opacity:0.6; font-size:0.85em;">@note.CreatedAt.ToLocalTime().ToString("MMM d, h:mm tt", System.Globalization.CultureInfo.InvariantCulture)</div>
                            <div style="white-space:pre-wrap; overflow-wrap:anywhere; word-break:break-word;">@note.Text</div>
                        </div>
                    }
                </FluentStack>
            }
        }

        @* Moved below the input (2026-11-06) -- a growing chat log used to push the input (and
           the Complete Stage button) further down the page with every reply, eventually off the
           visible area. The input now stays right under the heading regardless of log length.
           Its own heading added (2026-11-08) now that Notes sits between the chat box and this
           log -- without one, the log just ran on under Notes with nothing marking where it
           starts. *@
        <h2>Chat History</h2>
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="4">
            @foreach (var line in CurrentChatLog())
            {
                <div class="chat-line" style="max-width:100%; box-sizing:border-box; white-space:pre-wrap; overflow-wrap:anywhere; word-break:break-word;">
                    <strong>@line.Who:</strong> @line.Text
                </div>
            }
        </FluentStack>
    }
}

@code {
    [Parameter] public string WorkflowId { get; set; } = "";

    private WorkflowSummary? _workflow;
    private List<StageSummary>? _stages;
    private List<ItemSummary>? _items;

    // Jobs-list search (2026-11-08): tap-to-search, not live-as-you-type -- _searchResults stays
    // null until Search is tapped, which is also what the Jobs list checks to decide whether to
    // render _items (nothing searched yet) or these results instead.
    private string _searchQuery = "";
    private List<ItemSearchResult>? _searchResults;
    private bool _searching;

    private async Task RunSearch()
    {
        if (string.IsNullOrWhiteSpace(_searchQuery) || _searching) return;
        _searching = true;
        try
        {
            _searchResults = await Api.SearchItemsAsync(WorkflowId, _searchQuery);
        }
        finally
        {
            _searching = false;
        }
    }

    private void ClearSearch()
    {
        _searchQuery = "";
        _searchResults = null;
    }
    private string? _error;

    // Drill-down state: null/null = Jobs list; item set, stage null = job detail (stages);
    // both set = stage view. 2026-10-21: there is no structured event log anywhere in this UI
    // any more (tried a per-stage Log, then a flat Activity log -- both just showed computer-ish
    // "Moved to X" noise, including entries from stage moves nobody actually narrated). The chat
    // itself is now the only record, scoped per view via CurrentChatLog() below: each chat line is
    // tagged with the item/stage that was selected when it was sent, so drilling into a stage
    // shows only the conversation that happened there, not a separate structured history.
    private ItemSummary? _selectedItem;
    private string? _selectedStageId;

    // "+ New Job" on the Jobs list -- a third state alongside _selectedItem/_selectedStageId,
    // only meaningful while both of those are null. Shows the initial stage's checklist as a
    // guide and reuses the Jobs list's own chat box (still item_id/stage_id null, same as any
    // pre-creation chat) rather than a separate flow -- Send() below watches for the resulting
    // item count increase and auto-drills into the new job's stage once it exists.
    private bool _newJobMode;
    private int _newJobChatStartIndex;

    private string ItemLabelSingular =>
        string.IsNullOrEmpty(_workflow?.ItemLabel) ? "Item" :
        char.ToUpperInvariant(_workflow.ItemLabel[0]) + _workflow.ItemLabel[1..];
    private string ItemLabelPlural => ItemLabelSingular + "s";
    private string _draft = "";
    private bool _sending;
    private bool _saveAsNote;

    // One Claude-facing conversation per job (keyed by item id; "__general__" covers the Jobs
    // list / New Job screen, where no item is selected yet) instead of one array for the whole
    // session -- so a request about Job #9 never resends Jobs #1-8's history, and token cost per
    // request stays bounded by that one job's own activity (2026-11-07; not scoped further to
    // per-stage, since cross-stage memory within a job -- e.g. recalling diagnosis notes while
    // writing the estimate -- was judged more valuable than the extra savings).
    private readonly Dictionary<string, JsonArray> _messagesByJob = new();
    private string MessagesKey => _selectedItem?.Id ?? "__general__";
    private JsonArray CurrentMessages()
    {
        if (!_messagesByJob.TryGetValue(MessagesKey, out var arr))
        {
            arr = new JsonArray();
            _messagesByJob[MessagesKey] = arr;
        }
        return arr;
    }

    private readonly List<(string Who, string Text, string? ItemId, string? StageId)> _chatLog = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _workflow = await Api.GetWorkflowAsync(WorkflowId);
            _stages = await Api.GetStagesAsync(WorkflowId);
            _items = await Api.GetItemsAsync(WorkflowId);

            // Chat is the only record (2026-10-21 redesign) and must survive a page reload --
            // caught 2026-10-23: _chatLog used to live only in this component's memory, so
            // reloading the page silently wiped every conversation. Reload it from storage here
            // the same way it's written in Send() below.
            var history = await Api.GetChatMessagesAsync(WorkflowId);
            foreach (var m in history)
                _chatLog.Add((DisplayWho(m.Who), m.Body, m.ItemId, m.StageId));
        }
        catch (Exception ex)
        {
            _error = $"Couldn't load workflow: {ex.Message}";
        }
    }

    private static string DisplayWho(string who) => who switch
    {
        "user" => "You",
        "agent" => "Agent",
        "error" => "Error",
        "note" => "Note",
        _ => who,
    };

    private static string StoredWho(string displayWho) => displayWho switch
    {
        "You" => "user",
        "Agent" => "agent",
        "Error" => "error",
        "Note" => "note",
        _ => displayWho,
    };

    // The agent writes date/time fields (e.g. scheduled_at) as plain ISO 8601 strings -- shown
    // as-is that reads as a raw timestamp rather than something a human would say out loud
    // (2026-11-06). Reformat it if the key itself looks date-ish (avoids misreading an unrelated
    // string, e.g. an address or phone number, that happens to parse as a DateTime) and the value
    // round-trips through DateTime parsing; anything else is left untouched.
    private static string FieldText(string key, JsonNode? value) =>
        value switch
        {
            null => "null",
            JsonValue v when v.GetValueKind() == System.Text.Json.JsonValueKind.String &&
                LooksLikeDateField(key) &&
                DateTime.TryParse(v.GetValue<string>(), System.Globalization.CultureInfo.InvariantCulture,
                    System.Globalization.DateTimeStyles.None, out var dt)
                => dt.ToString("MMMM d, yyyy, h:mm tt", System.Globalization.CultureInfo.InvariantCulture),
            JsonValue v => v.ToString(),
            _ => value.ToJsonString(),
        };

    private static bool LooksLikeDateField(string key) =>
        key.Contains("date", StringComparison.OrdinalIgnoreCase) ||
        key.Contains("time", StringComparison.OrdinalIgnoreCase) ||
        key.EndsWith("_at", StringComparison.OrdinalIgnoreCase);

    // Shown on whichever stage collects scheduled_at (e.g. "scheduling"), so a dispatcher can
    // see what's already booked while scheduling a new job -- doesn't touch the agent/chat path
    // at all, just filters/sorts items already fetched for this workflow (2026-11-07).
    private IEnumerable<(ItemSummary Item, DateTime When)> UpcomingAppointments()
    {
        if (_items is null) yield break;
        var parsed = _items
            .Where(item => item.Id != _selectedItem?.Id) // don't list the job we're already viewing
            .Select(item => (
                Item: item,
                Parsed: item.Data.TryGetPropertyValue("scheduled_at", out var v) &&
                    v is JsonValue jv && jv.GetValueKind() == System.Text.Json.JsonValueKind.String &&
                    DateTime.TryParse(jv.GetValue<string>(), System.Globalization.CultureInfo.InvariantCulture,
                        System.Globalization.DateTimeStyles.None, out var dt)
                    ? dt : (DateTime?)null))
            .Where(x => x.Parsed is not null)
            .OrderBy(x => x.Parsed)
            .Take(10);
        foreach (var x in parsed) yield return (x.Item, x.Parsed!.Value);
    }

    private string ItemTitle(ItemSummary item)
    {
        var key = TitleKey(item);
        if (key is not null && item.Data[key] is JsonValue jv) return jv.GetValue<string>();
        return $"{ItemLabelPlural.TrimEnd('s')} {item.Id[..Math.Min(8, item.Id.Length)]}";
    }

    // A stable, permanent per-workflow identifier (unlike the Jobs list's display order, which
    // tracks updated_at and shifts as jobs get touched). Ranked by created_at ascending; items
    // are never deleted (no DELETE policy on `items`), so a job's number never changes once
    // assigned.
    private int JobNumber(ItemSummary item) =>
        _items is null ? 0 : _items.OrderBy(i => i.CreatedAt).ToList().FindIndex(i => i.Id == item.Id) + 1;

    // No field names can be assumed in general (data is domain-agnostic jsonb), but a field
    // literally named "title" is a real convention the agent itself already uses when it creates
    // an item ("I'll create a new item titled...") -- prefer that key if present, since object
    // key order isn't guaranteed and picking "the first string field" broke once a job had more
    // than one text field (e.g. title + address + phone -- whichever came first in iteration
    // order "won," not necessarily the actual title). Falls back to the old first-string-field
    // guess only when no "title" key exists.
    private static string? TitleKey(ItemSummary item)
    {
        if (item.Data.Any(kv => string.Equals(kv.Key, "title", StringComparison.OrdinalIgnoreCase)))
            return item.Data.First(kv => string.Equals(kv.Key, "title", StringComparison.OrdinalIgnoreCase)).Key;

        foreach (var (k, v) in item.Data)
        {
            if (v is JsonValue jv && jv.GetValueKind() == System.Text.Json.JsonValueKind.String)
                return k;
        }
        return null;
    }

    // Every data field except the title (already shown as the heading) -- shown only in a stage
    // view, not on the Jobs list (2026-10-25: showing every field on the list card got cluttered
    // as jobs picked up more fields; the list now stays to title + current stage, full detail
    // lives one level down).
    private static IEnumerable<KeyValuePair<string, JsonNode?>> ItemFields(ItemSummary item)
    {
        var titleKey = TitleKey(item);
        return item.Data.Where(kv => kv.Key != titleKey);
    }

    // Which stage each field was last written at -- key: stage_id, rebuilt from this item's
    // event history whenever a stage is selected. A null value means the field's origin stage is
    // unknown (e.g. an item created before 2026-10-20's create_item fix, which never recorded
    // stage_id) -- such a field won't show in ANY stage view, only pre-stage-filter data would
    // have shown it, which is an acceptable gap for old test data.
    private readonly Dictionary<string, string?> _fieldStage = new();

    private List<ItemNote>? _notes;

    // null stageId -> job-level notes (shown on the job overview page); a real stage id ->
    // that stage's own notes (shown on its drilled-in view). Split by StageId alone, not by
    // anything else, so a note's home page is decided entirely by where it was saved from
    // (2026-11-08).
    private List<ItemNote> NotesFor(string? stageId) =>
        _notes?.Where(n => n.StageId == stageId).ToList() ?? new List<ItemNote>();

    private async Task LoadFieldStageMap(string itemId)
    {
        _fieldStage.Clear();
        var eventsTask = Api.GetItemEventsAsync(itemId);
        var notesTask = Api.GetNotesAsync(itemId);
        var events = await eventsTask;
        _notes = await notesTask;
        foreach (var e in events)
        {
            if (e.Data is null) continue;
            foreach (var (key, value) in e.Data)
            {
                if (e.EventType == "item.data_changed" && value is null)
                    _fieldStage.Remove(key);
                else if (e.EventType is "item.created" or "item.data_changed")
                    _fieldStage[key] = e.StageId;
            }
        }
    }

    // A field shows under a stage if either: it's on that stage's own checklist (regardless of
    // when it was actually written -- 2026-11-06: a field is routinely filled in one message
    // before the user confirms moving to the stage it belongs to, e.g. "scheduled_at" typed while
    // still in Intake, right before confirming the move to Scheduling, so it got Intake-tagged
    // and never showed under Scheduling despite Scheduling's own checklist marking it done); or
    // it was last written while that stage was active and isn't on any checklist, i.e. an ad-hoc
    // field with no declared home stage (2026-10-25: the original behavior, still wanted for
    // those -- an Intake-only field set later while sitting at Scheduling shouldn't show there).
    private IEnumerable<KeyValuePair<string, JsonNode?>> ItemFieldsForStage(ItemSummary item, string? stageId)
    {
        var checklist = _stages?.FirstOrDefault(s => s.Id == stageId)?.Checklist ?? [];
        return ItemFields(item).Where(kv =>
            checklist.Contains(kv.Key) ||
            (_fieldStage.TryGetValue(kv.Key, out var s) && s == stageId));
    }

    private string StageTitle(string? stageId) =>
        Capitalize((_stages?.FirstOrDefault(s => s.Id == stageId)?.Title ?? stageId ?? "").Replace('_', ' '));

    // Display-only -- stage titles are stored lowercase (some with underscores, e.g.
    // payment_receipt_submitted), so this just capitalizes the first letter rather than
    // rewriting the whole string.
    private static string Capitalize(string s) =>
        string.IsNullOrEmpty(s) ? s : char.ToUpperInvariant(s[0]) + s[1..];

    // Checklist entries are data-field keys (snake_case, e.g. "scheduled_at"), chosen to match
    // exactly so "is this done" can just check item.Data for that key -- this turns the key back
    // into something readable for display.
    private static string ChecklistLabel(string field) => Capitalize(field.Replace('_', ' '));

    private async Task SelectItem(ItemSummary item)
    {
        _selectedItem = item;
        _selectedStageId = null;
        _notes = null; // show the spinner while this item's own notes load, not the last item's
        await LoadFieldStageMap(item.Id);
    }

    private void StartNewJob()
    {
        _newJobChatStartIndex = _chatLog.Count;
        _newJobMode = true;
    }
    private void CancelNewJob() => _newJobMode = false;

    private async Task SelectStage(string stageId)
    {
        _selectedStageId = stageId;
        await LoadFieldStageMap(_selectedItem!.Id);
    }

    // Same ordering as the Stages overview list -- "next" is simply the next one in sequence.
    private StageSummary? NextStage(string stageId)
    {
        var ordered = _stages!.OrderBy(s => s.SequenceOrder ?? int.MaxValue).ToList();
        var i = ordered.FindIndex(s => s.Id == stageId);
        return i >= 0 && i + 1 < ordered.Count ? ordered[i + 1] : null;
    }

    // The next stage to offer the Done button for, or null if the current stage has no checklist,
    // the checklist isn't fully filled in yet, or there's no next stage to move to.
    private StageSummary? DoneNextStage()
    {
        if (_selectedItem is null || _selectedStageId is null) return null;
        if (_stages!.FirstOrDefault(s => s.Id == _selectedStageId) is not { Checklist.Count: > 0 } stage) return null;
        if (!stage.Checklist.All(f => _selectedItem.Data.TryGetPropertyValue(f, out var v) && v is not null)) return null;
        return NextStage(stage.Id);
    }

    private bool _movingStage;

    // The chat-driven move_stage tool asks the user to confirm before moving on -- this button is
    // the shortcut for when the checklist is already complete and that confirmation is just
    // friction (2026-11-05).
    private async Task DoneMoveToNextStage(string toStageId)
    {
        if (_movingStage || _selectedItem is null) return;
        _movingStage = true;
        try
        {
            await Api.MoveStageAsync(_selectedItem.Id, toStageId);
            _items = await Api.GetItemsAsync(WorkflowId);
            _selectedItem = _items.FirstOrDefault(i => i.Id == _selectedItem.Id);
            _selectedStageId = toStageId;
            if (_selectedItem is not null)
                await LoadFieldStageMap(_selectedItem.Id);
        }
        finally
        {
            _movingStage = false;
        }
    }

    private void BackToItem() => _selectedStageId = null;

    private void BackToList()
    {
        _selectedItem = null;
        _selectedStageId = null;
    }

    // Chat lines are tagged with whatever was selected when they were sent -- drilled into a
    // stage, a job with no stage selected, or neither (the Jobs list). A stage view shows its own
    // stage-tagged lines PLUS the job's general (no-stage) lines -- e.g. the job-creation
    // conversation, which necessarily happens before any stage view exists to tag it with, still
    // needs to show up once you're looking at the job's current stage (2026-10-21: it didn't,
    // which read as "the chat for the current stage is empty" even though the job clearly had a
    // conversation behind it). The job-level view (item selected, no stage) stays untouched by
    // this -- it shows only its own no-stage lines, not every stage's lines layered in.
    // New-job mode shows no-item chat lines too (same shape as the Jobs list's own chat, since no
    // item exists yet to tag them with) -- but scoped to lines added since this New Job screen was
    // opened, otherwise every past job-creation conversation (all also itemId-less at the time they
    // were sent) would show up here too (2026-11-06).
    private IEnumerable<(string Who, string Text, string? ItemId, string? StageId)> CurrentChatLog() =>
        _newJobMode
            ? _chatLog.Skip(_newJobChatStartIndex).Where(l => l.ItemId is null)
            : _chatLog.Where(l => l.ItemId == _selectedItem?.Id &&
                (l.StageId == _selectedStageId || (_selectedStageId is not null && l.StageId is null)));

    // iOS Safari only opens the keyboard (and its dictation mic icon) from a focus() call made
    // synchronously inside a real tap handler -- autofocus and any focus triggered by page
    // load/render are silently ignored (2026-10-25). This button's own tap is that gesture.
    private Task FocusChatInput() => JS.InvokeVoidAsync("focusChatInput").AsTask();

    private async Task Send()
    {
        if (string.IsNullOrWhiteSpace(_draft) || _sending) return;
        var text = _draft;
        _draft = "";
        var itemId = _selectedItem?.Id;
        var stageId = _selectedStageId;
        var messagesKey = MessagesKey;
        var wasNewJobMode = _newJobMode;
        var previousItemCount = _items!.Count;
        _sending = true;

        // "Save as note" bypasses the agent entirely -- no AI round trip, so there's no more
        // guessing whether a given message became a note vs. stayed as plain chat; checking the
        // box makes that decision explicit instead of leaving it to the model's judgment calls
        // (content-based or the 5-message nudge below). Reset after every send so it has to be
        // deliberately re-checked for the next message, rather than silently staying on and
        // turning a later real instruction into a note instead of acting on it (2026-11-08).
        if (_saveAsNote && itemId is not null)
        {
            _saveAsNote = false;
            try
            {
                // Neither shown in the chat log nor persisted to chat_messages -- when saving
                // as a note, the note itself (visible in the Notes section) is the record, so
                // the chat has nothing to add (2026-11-08).
                await Api.AddNoteAsync(itemId, text, stageId);
                _notes = await Api.GetNotesAsync(itemId);
            }
            catch (Exception ex)
            {
                _chatLog.Add(("Error", ex.Message, itemId, stageId));
                await Api.AddChatMessageAsync(WorkflowId, StoredWho("Error"), ex.Message, itemId, stageId);
            }
            finally
            {
                _sending = false;
            }
            return;
        }

        _chatLog.Add(("You", text, itemId, stageId));
        await Api.AddChatMessageAsync(WorkflowId, StoredWho("You"), text, itemId, stageId);

        var currentMessages = CurrentMessages();
        currentMessages.Add(new JsonObject { ["role"] = "user", ["content"] = text });

        try
        {
            // Never send the other-jobs queue (2026-11-08). While a specific job is drilled
            // into, the agent should act on that job alone -- sending other jobs' names/details
            // here is how a future name collision (e.g. two different "Bob"s) could get
            // misapplied, even with the stronger job-grounding fix above. New Job mode has no
            // legitimate use for it either now that it's the only "no job open" state the chat
            // box is reachable from (the bare Jobs list no longer has a chat box at all) -- there's
            // no reason job creation should ever be able to reference an existing job by name or
            // number. An empty queue means the model has nothing else to reference, period.
            var queueForThisTurn = new JsonArray();
            // How many of the user's own messages have been sent in this exact job+stage so far
            // (including this one) -- lets the agent nudge toward add_note once a stage's chat
            // runs long, rather than letting detail pile up indefinitely as raw conversation
            // text that costs tokens on every later message in the same stage (2026-11-07).
            var stageMessageCount = stageId is null ? (int?)null :
                _chatLog.Count(l => l.Who == "You" && l.ItemId == itemId && l.StageId == stageId);
            var (reply, messages) = await Api.SendAgentMessageAsync(
                WorkflowId, queueForThisTurn, currentMessages,
                selectedItemId: _selectedItem?.Id,
                selectedItemLabel: _selectedItem is null ? null : ItemTitle(_selectedItem),
                // null on the job overview page (item selected, no stage drilled in) -- that's
                // what makes an agent-written add_note there land as a job-level note (2026-11-08).
                selectedStageTitle: _selectedStageId is not null ? StageTitle(_selectedStageId) : null,
                selectedStageId: _selectedStageId,
                selectedJobNumber: _selectedItem is null ? null : JobNumber(_selectedItem),
                selectedStageMessageCount: stageMessageCount);
            _messagesByJob[messagesKey] = messages;
            _chatLog.Add(("Agent", reply, itemId, stageId));
            await Api.AddChatMessageAsync(WorkflowId, StoredWho("Agent"), reply, itemId, stageId);
            _items = await Api.GetItemsAsync(WorkflowId);
            if (_selectedItem is not null)
                _selectedItem = _items.FirstOrDefault(i => i.Id == _selectedItem.Id);
            if (_selectedItem is not null && _selectedStageId is not null)
                await LoadFieldStageMap(_selectedItem.Id);

            // New-job mode: once create_item actually lands (items grew by one), drop straight
            // into the new job's own stage view instead of leaving the user back on the Jobs
            // list -- GetItemsAsync orders by updated_at desc, so the newest item is first.
            if (wasNewJobMode && _items.Count > previousItemCount)
            {
                _newJobMode = false;
                _selectedItem = _items[0];
                _selectedStageId = _selectedItem.StageId;
                await LoadFieldStageMap(_selectedItem.Id);
            }
        }
        catch (Exception ex)
        {
            _chatLog.Add(("Error", ex.Message, itemId, stageId));
            await Api.AddChatMessageAsync(WorkflowId, StoredWho("Error"), ex.Message, itemId, stageId);
        }
        finally
        {
            _sending = false;
        }
    }

}
